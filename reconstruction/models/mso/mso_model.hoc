// MSO multicompartment cell, used by every pipeline (LFP, ABR, NEURON chain).
// Subthreshold-active: KLT + Ih, no sodium and no axon, so it does not spike;
// its dipole is the synaptic one shaped by the voltage-dependent currents.
//
// Morphology: soma 20 x 20 um; dend_medial (+z) and dend_lateral (-z), 150 um
// each, 3.5 um diameter.
//
// Membrane (MSO whole-cell data, liquid-junction corrected):
//   rest      -60 mV = params.MSO_V_INIT, held by Ih against KLT
//   cm        1.0 uF/cm2
//   leak      3.33e-5 S/cm2, E_leak -70 mV
//   KLT       E_K -90 mV;  Ih  E_h -35 mV
//   KLT and Ih follow a soma > dendrite gradient, fitted at 37 degC to rest
//   -60 mV and Rin 16.2 MOhm (MSO range 3.7-24 MOhm): tau_m = 0.45 ms.
//   Inhibitory synapses reverse at params.MSO_INH_REV = -90 mV.
//
// Conductances (S/cm2):
//   soma:       klt 0.00293   ih 0.00463
//   dendrites:  klt 0.00062   ih 0.00097

create soma, dend_medial, dend_lateral

access soma

soma {
    nseg = 1
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 3.33e-5
    e_pas = -70.0
    insert klt
    gbar_klt = 0.00293
    insert ih
    gbar_ih = 0.00463
    eh_ih = -35.0
    ek = -90.0
    pt3dadd(0, 0, -10, 20)
    pt3dadd(0, 0, 10, 20)
}

dend_medial {
    nseg = 11
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 3.33e-5
    e_pas = -70.0
    insert klt
    gbar_klt = 0.00062
    insert ih
    gbar_ih = 0.00097
    eh_ih = -35.0
    ek = -90.0
    pt3dadd(0, 0, 10, 3.5)
    pt3dadd(0, 0, 160, 3.5)
}

dend_lateral {
    nseg = 11
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 3.33e-5
    e_pas = -70.0
    insert klt
    gbar_klt = 0.00062
    insert ih
    gbar_ih = 0.00097
    eh_ih = -35.0
    ek = -90.0
    pt3dadd(0, 0, -10, 3.5)
    pt3dadd(0, 0, -160, 3.5)
}

connect dend_medial(0), soma(1)
connect dend_lateral(0), soma(0)
