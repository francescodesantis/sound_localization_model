// MNTB principal neuron: multicompartment morphology with active conductances.
//
// Morphology (human principal neuron; Kulesza 2015, Srinivasan 2019):
//   soma    ~20 um diameter
//   dend    one primary pole: two 60 um x 3 um branches leaving +z, splayed
//           +/-20 um in x (the x-components cancel, the z-components add, so the
//           dipole lies along the dendritic long axis)
//   ais     20 um, along -y, at 90 deg to the dendrites
//   axon    100 um, along -y (caudal)
//
// Channels: namntb (models/mntb), klt_mntb, kht_mntb, ih_mntb (Rothman & Manis
// 2003 kinetics), at 37 degC. Phasic to a DC step; driven by brief
// suprathreshold calyx EPSCs it fires one spike per event and follows
// 200-400 Hz (validate_mntb.py).
//
// Passive parameters from the NEST point neuron (MEMB_CAPS.MNTBC 18.9 pF,
// G_LEAK.MNTBC 9 nS) over the total membrane area (2971.9 um2):
//   cm    = 0.636 uF/cm2,  g_pas = 0.0003028 S/cm2,  e_pas = -70 mV (E_L.MNTBC)
//   Ra    = 150 ohm.cm
//
// Conductances (S/cm2):
//   soma:  namntb 0.12, kht 0.020, klt 0.020, ih 0.0022
//   dend:  kht 0.002, klt 0.004, ih 0.0008                 (no Na)
//   ais:   namntb 0.40, kht 0.020, klt 0.020               (no Ih)
//   axon:  namntb 0.30, kht 0.015, klt 0.010, ih 0.0002

create soma, dend_A, dend_B, ais, axon

access soma

soma {
    nseg = 1
    Ra   = 150
    cm   = 0.636
    insert pas
    g_pas = 0.0003028
    e_pas = -70.0
    insert klt_mntb
    gbar_klt_mntb = 0.020
    insert kht_mntb
    gbar_kht_mntb = 0.020
    insert ih_mntb
    gbar_ih_mntb = 0.0022
    insert namntb
    gbar_namntb = 0.12
    ena = 55.0
    ek  = -77.0
    pt3dadd(0, 0, -10, 20)
    pt3dadd(0, 0,  10, 20)
}

// Primary-dendrite branch A  (+z, splayed +x, 60 um, dia 3 um)
//   60 um includes the two ~10 um distal tufts. Both branches leave the same pole.
dend_A {
    nseg = 5
    Ra   = 150
    cm   = 0.636
    insert pas
    g_pas = 0.0003028
    e_pas = -70.0
    insert klt_mntb
    gbar_klt_mntb = 0.004
    insert kht_mntb
    gbar_kht_mntb = 0.002
    insert ih_mntb
    gbar_ih_mntb = 0.0008
    ek = -77.0
    pt3dadd(0, 0, 10, 3)
    pt3dadd(20, 0, 66.6, 3)
}


// Primary-dendrite branch B  (+z, splayed -x, 60 um, dia 3 um)
dend_B {
    nseg = 5
    Ra   = 150
    cm   = 0.636
    insert pas
    g_pas = 0.0003028
    e_pas = -70.0
    insert klt_mntb
    gbar_klt_mntb = 0.004
    insert kht_mntb
    gbar_kht_mntb = 0.002
    insert ih_mntb
    gbar_ih_mntb = 0.0008
    ek = -77.0
    pt3dadd(0, 0, 10, 3)
    pt3dadd(-20, 0, 66.6, 3)
}

// Axon initial segment (-y, 20 um), at 90 deg to the dendrites; high Na
ais {
    nseg = 3
    Ra   = 150
    cm   = 0.636
    insert pas
    g_pas = 0.0003028
    e_pas = -70.0
    insert namntb
    gbar_namntb = 0.40
    ena = 55.0
    insert kht_mntb
    gbar_kht_mntb = 0.020
    insert klt_mntb
    gbar_klt_mntb = 0.020
    ek = -77.0
    pt3dadd(0,   0, 0, 1.8)
    pt3dadd(0, -20, 0, 1.5)
}

// Axon (-y / caudal, 100 um)
axon {
    nseg = 3
    Ra   = 150
    cm   = 0.636
    insert pas
    g_pas = 0.0003028
    e_pas = -70.0
    insert namntb
    gbar_namntb = 0.30
    ena = 55.0
    insert kht_mntb
    gbar_kht_mntb = 0.015
    insert klt_mntb
    gbar_klt_mntb = 0.010
    insert ih_mntb
    gbar_ih_mntb = 0.0002
    ek = -77.0
    pt3dadd(0,  -20, 0, 1.5)
    pt3dadd(0, -120, 0, 1.5)
}

connect dend_A(0),  soma(1)
connect dend_B(0),  soma(1)
connect ais(0),     soma(0.5)
connect axon(0),    ais(1)
